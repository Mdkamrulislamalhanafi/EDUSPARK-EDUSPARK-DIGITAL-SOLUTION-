   School & Madrasa Management
================================= */

:root {
  --primary: #0757a6;
  --secondary: #0788e8;
  --success: #07945b;
  --dark: #12345a;
  --light: #f2f7fd;
  --white: #ffffff;
  --text: #26384d;
  --muted: #718096;
  --border: #e1eaf4;
  --shadow: 0 8px 25px rgba(10,65,120,.09);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: var(--light);
  color: var(--text);
  line-height: 1.6;
}

/* HEADER */

header {
  background: linear-gradient(135deg,#06447f,#0789e8);
  color: white;
  padding: 28px 15px;
  text-align: center;
  box-shadow: var(--shadow);
}

header h1 {
  font-size: 30px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

header p {
  font-size: 14px;
  margin-top: 5px;
  color: #e1f2ff;
}

/* MAIN CONTAINER */

.container {
  width: 100%;
  max-width: 1150px;
  margin: auto;
  padding: 20px 15px;
}

/* CARD */

.card {
  background: var(--white);
  border-radius: 17px;
  padding: 23px;
  margin-bottom: 20px;
  box-shadow: var(--shadow);
  border: 1px solid var(--border);
}

h2 {
  color: var(--primary);
  margin-bottom: 12px;
  font-size: 23px;
}

h3 {
  color: var(--dark);
  margin: 22px 0 14px;
}

/* INPUT */

label {
  display: block;
  font-size: 14px;
  font-weight: bold;
  margin-top: 12px;
  color: var(--dark);
}

input,
select,
textarea {
  display: block;
  width: 100%;
  padding: 13px;
  margin-top: 7px;
  border: 1px solid #d5e1ee;
  border-radius: 10px;
  font-size: 15px;
  background: #fff;
  color: var(--text);
  outline: none;
  transition: .2s;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--secondary);
  box-shadow: 0 0 0 3px rgba(7,136,232,.12);
}

textarea {
  min-height: 100px;
  resize: vertical;
}

/* BUTTON */

button {
  border: none;
  border-radius: 10px;
  padding: 12px 18px;
  background: linear-gradient(135deg,#0757a6,#0788e8);
  color: white;
  font-size: 14px;
  font-weight: bold;
  cursor: pointer;
  transition: .2s;
  margin: 5px 3px;
}

button:hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 14px #0757a633;
}

button:disabled {
  opacity: .6;
  cursor: not-allowed;
}

.secondary {
  background: #e7f2ff;
  color: var(--primary);
}

.logout {
  background: #d93636;
}

/* LOGIN */

#login {
  max-width: 470px;
  margin: 35px auto;
  padding: 28px;
}

#login h2 {
  text-align: center;
}

#login button {
  width: 100%;
  margin: 8px 0;
  padding: 14px;
}

#message {
  color: #d12c2c;
  font-size: 13px;
  margin-top: 10px;
  overflow-wrap: anywhere;
}

/* DASHBOARD */

#dashboard {
  animation: appear .4s ease;
}

@keyframes appear {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* STATISTICS */

.stat {
  background: linear-gradient(145deg,#ffffff,#e8f4ff);
  border: 1px solid #dcecff;
  border-radius: 15px;
  padding: 20px 10px;
  text-align: center;
  box-shadow: var(--shadow);
  font-size: 25px;
}

.stat strong {
  display: block;
  color: var(--primary);
  font-size: 27px;
  margin: 5px 0;
}

.stat:hover {
  transform: translateY(-3px);
}

/* GRID */

.grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 13px;
}

/* MANAGEMENT MODULES */

.module {
  min-height: 115px;
  border-radius: 15px;
  padding: 17px 12px;
  background: linear-gradient(135deg,#087bc9,#0752a3);
  color: white;
  text-align: left;
  font-size: 15px;
  box-shadow: 0 5px 15px #0757a629;
  border: 1px solid #ffffff30;
}

.module span {
  display: block;
  font-size: 27px;
  margin-bottom: 8px;
}

.module:hover {
  background: linear-gradient(135deg,#07945b,#08a96a);
}

/* TABLE */

.tablewrap {
  width: 100%;
  overflow-x: auto;
  margin-top: 17px;
  border-radius: 10px;
}

table {
  width: 100%;
  border-collapse: collapse;
  background: white;
  min-width: 500px;
}

th {
  background: #eaf3fc;
  color: var(--primary);
  font-weight: bold;
}

th, td {
  padding: 12px;
  text-align: left;
  border-bottom: 1px solid var(--border);
  font-size: 13px;
}

tr:hover td {
  background: #f6faff;
}

/* HIDDEN */

.hidden {
  display: none !important;
}

/* FOOTER */

footer {
  text-align: center;
  background: #073d70;
  color: white;
  padding: 24px 12px;
  margin-top: 30px;
  font-size: 13px;
}

/* MOBILE */

@media(max-width: 480px) {

  header {
    padding: 22px 10px;
  }

  header h1 {
    font-size: 25px;
  }

  .container {
    padding: 12px;
  }

  .card {
    padding: 16px;
    border-radius: 13px;
  }

  h2 {
    font-size: 20px;
  }

  .grid {
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 9px;
  }

  .module {
    min-height: 105px;
    padding: 12px 9px;
    font-size: 13px;
  }

  .module span {
    font-size: 24px;
  }

  .stat {
    padding: 13px 5px;
    font-size: 21px;
  }

  .stat strong {
    font-size: 23px;
  }

  button {
    padding: 12px;
  }
}

/* TABLET AND DESKTOP */

@media(min-width: 768px) {
  .grid {
    grid-template-columns: repeat(4,minmax(0,1fr));
  }
}
