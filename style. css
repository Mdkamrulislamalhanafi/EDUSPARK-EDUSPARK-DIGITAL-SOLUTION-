
/* =================================
   EduSpark Digital Solution
   Green + Yellow + White Theme
   ================================= */

:root {
  --primary: #16834A;
  --primary-dark: #086335;
  --secondary: #FACC15;
  --white: #FFFFFF;
  --background: #F5F9F6;
  --text: #18352A;
  --muted: #718078;
  --border: #E1EAE4;
  --shadow: 0 4px 18px rgba(0, 80, 40, 0.08);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, "Noto Sans Bengali", sans-serif;
  background: var(--background);
  color: var(--text);
  line-height: 1.6;
}

button, input, select, textarea {
  font: inherit;
}

/* Header */

.header {
  background: var(--primary);
  color: var(--white);
  padding: 15px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo {
  width: 55px;
  height: 55px;
  background: var(--white);
  color: var(--primary);
  border: 3px solid var(--secondary);
  border-radius: 14px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 21px;
  font-weight: 900;
}

.brand h1 {
  font-size: 22px;
}

.brand p {
  font-size: 12px;
  color: #E8F5EC;
}

/* Main Layout */

.app-layout {
  display: flex;
  min-height: calc(100vh - 85px);
}

/* Sidebar */

.sidebar {
  width: 250px;
  flex-shrink: 0;
  background: var(--primary-dark);
  color: var(--white);
  padding: 22px 14px;
}

.sidebar-title {
  color: var(--secondary);
  font-size: 13px;
  margin: 10px 12px;
  font-weight: bold;
}

.sidebar a {
  display: block;
  color: var(--white);
  text-decoration: none;
  padding: 12px 14px;
  margin: 5px 0;
  border-radius: 9px;
  transition: 0.2s;
}

.sidebar a:hover,
.sidebar a.active {
  background: var(--secondary);
  color: #18352A;
  font-weight: bold;
}

/* Main Content */

.main-content {
  flex: 1;
  min-width: 0;
  padding: 25px;
}

.page-title {
  color: var(--primary-dark);
  margin-bottom: 20px;
  font-size: 25px;
}

/* Dashboard Cards */

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px;
  box-shadow: var(--shadow);
}

.stat-card {
  border-left: 5px solid var(--primary);
}

.stat-card h3 {
  color: var(--muted);
  font-size: 14px;
}

.stat-card .number {
  color: var(--primary);
  font-size: 28px;
  font-weight: bold;
}

/* Buttons */

.btn {
  display: inline-block;
  border: none;
  border-radius: 9px;
  padding: 11px 20px;
  background: var(--primary);
  color: var(--white);
  font-weight: bold;
  cursor: pointer;
}

.btn:hover {
  background: var(--primary-dark);
}

.btn-yellow {
  background: var(--secondary);
  color: #18352A;
}

/* Forms */

.form-group {
  margin-bottom: 16px;
}

.form-group label {
  display: block;
  margin-bottom: 6px;
  font-weight: bold;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--white);
  outline: none;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(22, 131, 74, 0.1);
}

/* Tables */

.table-container {
  width: 100%;
  overflow-x: auto;
  background: var(--white);
  border-radius: 12px;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 550px;
}

th, td {
  padding: 12px;
  text-align: left;
  border-bottom: 1px solid var(--border);
}

th {
  background: #E8F4EC;
  color: var(--primary-dark);
}

/* Mobile Responsive */

@media (max-width: 900px) {
  .dashboard-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 650px) {
  .app-layout {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    padding: 10px;
  }

  .sidebar a {
    display: inline-block;
    padding: 9px 12px;
  }

  .main-content {
    padding: 15px;
  }

  .header {
    padding: 12px;
  }

  .brand h1 {
    font-size: 18px;
  }

  .dashboard-grid {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .card {
    padding: 14px;
  }

  .page-title {
    font-size: 21px;
  }
}

@media (max-width: 360px) {
  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}
