   EduSpark Digital Solution
   School & Madrasa Management System
===================================== */

:root {
  --primary: #16834A;
  --primary-dark: #086335;
  --secondary: #FACC15;
  --white: #FFFFFF;
  --background: #F5F9F6;
  --text: #18352A;
  --muted: #718078;
  --border: #E1EAE4;
  --shadow: 0 4px 18px rgba(0, 80, 40, 0.08);
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: Arial, "Noto Sans Bengali", sans-serif;
  background: var(--background);
  color: var(--text);
}

[hidden] { display: none !important; }

/* HEADER */
.header {
  min-height: 75px;
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 25px;
  border-bottom: 1px solid var(--border);
  box-shadow: var(--shadow);
}

.brand { display: flex; align-items: center; gap: 12px; }
.logo {
  width: 52px; height: 52px; display: flex;
  align-items: center; justify-content: center;
  overflow: hidden; border-radius: 10px;
  background: #e9f6ee;
}
.brand h1 { color: var(--primary); font-size: 23px; }
.brand p { color: var(--muted); font-size: 13px; }
.header-actions { display: flex; align-items: center; gap: 14px; }

/* MAIN LAYOUT */
.app-layout { display: flex; min-height: calc(100vh - 75px); }

/* SIDEBAR */
.sidebar {
  width: 250px; flex-shrink: 0;
  background: var(--primary-dark); padding: 22px 14px;
}
.sidebar-title {
  color: #c4e5d0; font-size: 12px;
  font-weight: bold; margin: 20px 10px 10px;
}
.sidebar a {
  display: block; text-decoration: none; color: white;
  padding: 12px 13px; margin: 5px 0;
  border-radius: 8px; font-size: 14px; transition: 0.2s;
}
.sidebar a:hover, .sidebar a.active {
  background: var(--secondary); color: var(--primary-dark);
}

/* MAIN CONTENT */
.main-content { flex: 1; min-width: 0; padding: 28px; }
.page-title {
  color: var(--primary-dark); margin-bottom: 22px; font-size: 25px;
}
.page-description { margin-bottom: 20px; color: var(--muted); }

/* CARDS */
.card {
  background: var(--white); border: 1px solid var(--border);
  border-radius: 12px; padding: 22px; box-shadow: var(--shadow);
}
.card h2, .card h3 { color: var(--primary-dark); margin-bottom: 10px; }
.card p { color: var(--muted); line-height: 1.7; }
.welcome-card { margin-bottom: 20px; }
.quick-grid { margin-top: 20px; }
.owner-card { margin-top: 22px; }

/* DASHBOARD GRID */
.dashboard-grid {
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}
.stat-card { border-left: 5px solid var(--primary); }
.stat-card .number {
  font-size: 32px; font-weight: bold;
  color: var(--primary); margin-top: 12px;
}

/* BUTTONS */
.btn {
  display: inline-block; background: var(--primary); color: white;
  padding: 11px 20px; border: none; border-radius: 7px; cursor: pointer;
}
.btn:hover { background: var(--primary-dark); }
.btn:disabled { opacity: .65; cursor: not-allowed; }
.btn-yellow { background: var(--secondary); color: var(--primary-dark); }
.btn-yellow:hover { background: #e8b900; }
.btn-logout { padding: 9px 14px; }

/* FORMS */
.form-group { margin-bottom: 16px; }
.form-group label { display: block; margin-bottom: 7px; font-weight: bold; }
.form-group input, .form-group select, .form-group textarea {
  width: 100%; padding: 12px; border: 1px solid var(--border);
  border-radius: 7px; font-size: 15px; background: white;
}

/* LOGIN */
.login-screen {
  position: fixed; inset: 0; z-index: 10000;
  display: flex; align-items: center; justify-content: center;
  padding: 20px; background: linear-gradient(135deg, #e9f6ee, #f5f9f6);
}
.login-box {
  width: 100%; max-width: 390px; padding: 30px 24px;
  border-radius: 16px; background: white; text-align: center;
  box-shadow: 0 8px 30px rgba(0, 80, 40, .13);
}
.login-logo { width: 85px; height: 85px; object-fit: contain; margin-bottom: 10px; }
.login-box h2 { color: var(--primary-dark); margin-bottom: 6px; }
.login-subtitle { color: var(--muted); margin-bottom: 24px; }
.login-box form { text-align: left; }
.login-button { width: 100%; font-size: 16px; }
.login-message, .student-message {
  min-height: 22px; margin-top: 12px; color: #b42318; line-height: 1.5;
}

/* STUDENTS */
.student-form-card, .student-list-card { margin-bottom: 20px; }
.student-form-grid {
  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px;
}
.student-form-grid .form-group { margin-bottom: 4px; }
.student-list-heading {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; margin-bottom: 14px;
}
.table-wrap { width: 100%; overflow-x: auto; }
table { width: 100%; border-collapse: collapse; background: white; }
th, td { padding: 12px; text-align: left; border-bottom: 1px solid var(--border); }
th { background: #e9f6ee; color: var(--primary-dark); white-space: nowrap; }
td { overflow-wrap: anywhere; }

/* FOOTER */
.app-footer {
  text-align: center; margin-top: 30px; color: var(--muted);
  line-height: 1.8; padding: 15px;
}

/* TABLET */
@media (max-width: 900px) {
  .dashboard-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .sidebar { width: 210px; }
  .main-content { padding: 20px; }
}

/* MOBILE */
@media (max-width: 650px) {
  .header { padding: 12px; gap: 10px; }
  .brand h1 { font-size: 19px; }
  .header-actions { gap: 8px; font-size: 12px; }
  .btn-logout { padding: 8px 10px; }
  .app-layout { flex-direction: column; }
  .sidebar { width: 100%; padding: 10px; }
  .sidebar-title { margin-top: 12px; }
  .sidebar a { display: inline-block; padding: 9px; font-size: 12px; }
  .main-content { padding: 15px; }
  .dashboard-grid { grid-template-columns: 1fr; }
  .student-form-grid { grid-template-columns: 1fr; gap: 0; }
  .page-title { font-size: 21px; }
  .card { padding: 17px; }
}
