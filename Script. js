// HTML Escape Utility for Security
function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, function (char) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char];
    });
}

// Load Students Data
let allStudents = [];
async function loadStudents() {
    const snap = await getDocs(studentCollection);
    allStudents = snap.docs.map(item => ({ id: item.id, ...item.data() }));
    studentCount.textContent = allStudents.length;
    showStudents(allStudents);
}

function showStudents(students) {
    if (students.length === 0) {
        studentList.textContent = "কোনো তথ্য নেই।";
        return;
    }
    studentList.innerHTML = "";
    students.forEach(s => {
        const card = document.createElement("div");
        card.className = "card";
        card.innerHTML = `<h3>${escapeHTML(s.studentName)}</h3><p>পিতা: ${escapeHTML(s.fatherName)}</p><p>রোল: ${escapeHTML(s.roll)} | শ্রেণি: ${escapeHTML(s.className)}</p><button type="button" class="edit-btn">Edit</button><button type="button" class="del-btn">Delete</button>`;
        
        card.querySelector(".edit-btn").onclick = () => {
            document.getElementById("studentId").value = s.id;
            document.getElementById("studentName").value = s.studentName || "";
            document.getElementById("fatherName").value = s.fatherName || "";
            document.getElementById("motherName").value = s.motherName || "";
            document.getElementById("dateOfBirth").value = s.dateOfBirth || "";
            document.getElementById("mobile").value = s.mobile || "";
            document.getElementById("rollNumber").value = s.roll || "";
            document.getElementById("department").value = s.department || "";
            document.getElementById("department").dispatchEvent(new Event('change'));
            document.getElementById("className").value = s.className || "";
            window.scrollTo({top: 0, behavior: 'smooth'});
        };
        
        card.querySelector(".del-btn").onclick = async () => {
            if(confirm("মুছতে চান?")) {
                await deleteDoc(doc(db, "student_records", s.id));
                loadStudents();
            }
        };
        studentList.appendChild(card);
    });
}

studentSearch.addEventListener("input", (e) => {
    const txt = e.target.value.toLowerCase();
    showStudents(allStudents.filter(s => String(s.studentName || "").toLowerCase().includes(txt)));
});

// Load Certificates Data & Print Trigger
