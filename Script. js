    certList.innerHTML = "";
    certs.forEach(c => {
        const card = document.createElement("div");
        card.className = "card";
        card.innerHTML = `
            <h3>${escapeHTML(c.certType)}</h3>
            <p>শিক্ষার্থী: ${escapeHTML(c.studentName)} | পিতা: ${escapeHTML(c.fatherName)}</p>
