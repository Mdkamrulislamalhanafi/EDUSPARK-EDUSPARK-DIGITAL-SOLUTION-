async function loadFees() {
    const snap = await getDocs(feeCollection);
    const fees = snap.docs.map(item => ({ id: item.id, ...item.data() }));
    const feeListEl = document.getElementById("feeList");
    if(fees.length === 0) {
        feeListEl.textContent = "কোনো ফি রেকর্ড নেই।";
        return;
    }
    feeListEl.innerHTML = "";
    fees.forEach(f => {
        const card = document.createElement("div");
        card.className = "card";
        card.innerHTML = `<h3>${escapeHTML(f.studentName)} (${escapeHTML(f.month)})</h3><p>মোট: ৳${escapeHTML(f.totalFee)} | পরিশোধ: ৳${escapeHTML(f.feePaid)} | বকেয়া: ৳${escapeHTML(f.feeDue)}</p>`;
        feeListEl.appendChild(card);
    });
}

async function loadTeachers() {
    const snap = await getDocs(teacherCollection);
