// Helper Element Selector
function el(id) {
  return document.getElementById(id);
}

// ===================================
// DASHBOARD COUNTS
// ===================================
async function loadCounts() {
  if (!institutionId) {
    return;
  }
  const items = [
    ["students", "students"],
    ["teachers", "teachers"],
    ["staff", "staff"],
    ["notices", "notices"]
  ];
  for (const [id, collectionName] of items) {
    try {
      const snap = await db
        .collection("institutions")
        .doc(institutionId)
        .collection(collectionName)
        .get();
      el(id).textContent = snap.size.toLocaleString("bn-BD");
    } catch(error) {
      el(id).textContent = "—";
      console.error(error);
    }
  }
}

// ===================================
// CLOSE MODULE
