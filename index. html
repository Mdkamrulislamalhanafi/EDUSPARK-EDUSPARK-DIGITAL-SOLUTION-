// ===================================
// COMMON FUNCTIONS
// ===================================

function el(id) {
  return document.getElementById(id);
}


function showMessage(message) {
  el("message").textContent = message;
}


// ===================================
// LOGIN
// ===================================

el("loginForm").addEventListener("submit", async function(event) {

  event.preventDefault();

  const email = el("email").value.trim();

  const password = el("password").value;

  const btn = el("loginBtn");

  if (!email || !password) {

    showMessage("ইমেইল ও পাসওয়ার্ড লিখুন।");

    return;
  }

  btn.disabled = true;

  btn.textContent = "লগইন হচ্ছে...";

  showMessage("");

  try {

    await auth.signInWithEmailAndPassword(
      email,
      password
    );

  } catch(error) {

    const errors = {

      "auth/invalid-credential":
        "ইমেইল অথবা পাসওয়ার্ড ভুল।",

      "auth/user-not-found":
        "এই ইমেইলে কোনো অ্যাকাউন্ট নেই।",

      "auth/wrong-password":
        "পাসওয়ার্ড ভুল।",

      "auth/too-many-requests":
        "অনেকবার চেষ্টা করেছেন। পরে চেষ্টা করুন।",

      "auth/network-request-failed":
        "ইন্টারনেট সংযোগ পরীক্ষা করুন।",

      "auth/invalid-email":
        "সঠিক ইমেইল লিখুন।",

      "auth/unauthorized-domain":
        "এই ওয়েবসাইট Firebase Authorized Domains-এ যোগ করুন।"

    };

    showMessage(
      errors[error.code] || error.message
    );

  } finally {

    btn.disabled = false;

    btn.textContent = "লগইন করুন";

  }

});


// ===================================
// FORGOT PASSWORD
// ===================================

async function forgotPassword() {

  const email = el("email").value.trim();

  if (!email) {

    showMessage("প্রথমে ইমেইল লিখুন।");

    return;
  }

  try {

    await auth.sendPasswordResetEmail(email);

    showMessage(
      "পাসওয়ার্ড রিসেট লিংক ইমেইলে পাঠানো হয়েছে।"
    );

  } catch(error) {

    showMessage(error.message);

  }

}


// ===================================
// LOGOUT
// ===================================

async function logoutUser() {

  try {

    await auth.signOut();

  } catch(error) {

    alert(error.message);

  }

}


// ===================================
// AUTHENTICATION
// ===================================

auth.onAuthStateChanged(async function(user) {

  if (!user) {

    institutionId = null;

    currentModule = null;

    el("login").classList.remove("hidden");

    el("dashboard").classList.add("hidden");

    el("work").classList.add("hidden");

    return;
  }


  try {

    const profile = await db
      .collection("admins")
      .doc(user.uid)
      .get();


    if (!profile.exists) {

      alert("Admin Profile পাওয়া যায়নি।");

      await auth.signOut();

      return;
    }


    const data = profile.data();


    if (
      !data.institutionId ||
      data.status !== "active"
    ) {

      alert("আপনার Admin Account সক্রিয় নয়।");

      await auth.signOut();

      return;
    }


    institutionId = data.institutionId;


    el("welcome").textContent =
      "স্বাগতম, " + (data.adminName || "Admin") + "!";


    el("institution").textContent =
      data.institutionName || "EduSpark Institution";


    el("login").classList.add("hidden");

    el("dashboard").classList.remove("hidden");


    drawModules();

    await loadCounts();


  } catch(error) {

    alert("Firebase সমস্যা: " + error.message);

    await auth.signOut();

  }

});


// ===================================
// SHOW MODULES
// ===================================

function drawModules() {

  const area = el("modules");

  area.innerHTML = "";


  modules.forEach(function(module) {

    const btn = document.createElement("button");

    btn.className = "module";

    btn.type = "button";


    const icon = document.createElement("span");

    icon.textContent = module.icon;


    btn.appendChild(icon);

    btn.appendChild(
      document.createTextNode(module.name)
    );


    btn.addEventListener("click", function() {

      openModule(module.id);

    });


    area.appendChild(btn);

  });

}


// ===================================
// OPEN MODULE
// ===================================

function openModule(id) {

  currentModule = modules.find(function(module) {

    return module.id === id;

  });


  if (!currentModule || !institutionId) {

    return;
  }


  el("work").classList.remove("hidden");


  el("workTitle").textContent =
    currentModule.icon + " " + currentModule.name;


  const formArea = el("formArea");

  formArea.innerHTML = "";


  const form = document.createElement("form");

  form.id = "dataForm";


  const formGrid = document.createElement("div");

  formGrid.className = "form-grid";


  currentModule.fields.forEach(function(field, index) {

    const label = document.createElement("label");

    label.textContent = field;

    label.htmlFor = "field" + index;


    const input = document.createElement("input");

    input.type = "text";

    input.required = true;

    input.id = "field" + index;

    input.placeholder = field;


    formGrid.appendChild(label);

    formGrid.appendChild(input);

  });


  const save = document.createElement("button");

  save.type = "submit";

  save.textContent = "তথ্য সংরক্ষণ করুন";


  form.appendChild(formGrid);

  form.appendChild(save);


  formArea.appendChild(form);


  form.addEventListener("submit", saveRecord);


  el("tableHead").innerHTML =
    "<tr>" +
    currentModule.fields.map(function(field) {

      return "<th>" + escapeHTML(field) + "</th>";

    }).join("") +
    "</tr>";


  loadRows();


  el("work").scrollIntoView({
    behavior: "smooth"
  });

}


// ===================================
// SAVE RECORD
// ===================================

async function saveRecord(event) {

  event.preventDefault();


  if (!institutionId || !currentModule) {

    return;
  }


  const form = event.target;

  const button = form.querySelector("button");


  const data = {};


  currentModule.fields.forEach(function(field, index) {

    data[field] = el("field" + index).value.trim();

  });


  data.createdAt =
    firebase.firestore.FieldValue.serverTimestamp();


  data.createdBy = auth.currentUser.uid;


  button.disabled = true;

  button.textContent = "সংরক্ষণ হচ্ছে...";


  try {

    await db
      .collection("institutions")
      .doc(institutionId)
      .collection(currentModule.id)
      .add(data);


    alert("আলহামদুলিল্লাহ! তথ্য সংরক্ষিত হয়েছে।");


    form.reset();


    await loadRows();

    await loadCounts();


  } catch(error) {

    alert(
      "তথ্য সংরক্ষণ হয়নি: " + error.message
    );

  } finally {

    button.disabled = false;

    button.textContent = "তথ্য সংরক্ষণ করুন";

  }

}


// ===================================
// ESCAPE HTML
// ===================================

function escapeHTML(value) {

  return String(value).replace(/[&<>"']/g, function(char) {

    return {

      "&": "&amp;",

      "<": "&lt;",

      ">": "&gt;",

      '"': "&quot;",

      "'": "&#39;"

    }[char];

  });

}


// ===================================
// LOAD RECORDS
// ===================================

async function loadRows() {

  const body = el("tableBody");


  if (!currentModule || !institutionId) {

    return;
  }


  body.innerHTML =
    "<tr><td>লোড হচ্ছে...</td></tr>";


  try {

    const snap = await db
      .collection("institutions")
      .doc(institutionId)
      .collection(currentModule.id)
      .orderBy("createdAt", "desc")
      .limit(100)
      .get();


    body.innerHTML = "";


    if (snap.empty) {

      const tr = document.createElement("tr");

      const td = document.createElement("td");

      td.colSpan = currentModule.fields.length;

      td.textContent = "এখনো কোনো তথ্য নেই।";

      tr.appendChild(td);

      body.appendChild(tr);

      return;
    }


    snap.forEach(function(doc) {

      const data = doc.data();

      const tr = document.createElement("tr");


      currentModule.fields.forEach(function(field) {

        const td = document.createElement("td");

        td.textContent = data[field] || "-";

        tr.appendChild(td);

      });


      body.appendChild(tr);

    });


  } catch(error) {

    body.innerHTML = "";


    const tr = document.createElement("tr");

    const td = document.createElement("td");

    td.colSpan = currentModule.fields.length;

    td.textContent =
      "তথ্য আনা যায়নি: " + error.message;


    tr.appendChild(td);

    body.appendChild(tr);

  }

}


// ===================================
// DASHBOARD COUNTS
// ===================================

async function loadCounts() {

  if (!institutionId) {

    return;
  }


  const items = [

    ["students", "students"],

    ["teachers", "teachers"],

    ["staff", "staff"],

    ["notices", "notices"]

  ];


  for (const [id, collectionName] of items) {

    try {

      const snap = await db
        .collection("institutions")
        .doc(institutionId)
        .collection(collectionName)
        .get();


      el(id).textContent =
        snap.size.toLocaleString("bn-BD");


    } catch(error) {

      el(id).textContent = "—";

      console.error(error);

    }

  }

}


// ===================================
// CLOSE MODULE
// ===================================

function closeWork() {

  el("work").classList.add("hidden");

  currentModule = null;

}


