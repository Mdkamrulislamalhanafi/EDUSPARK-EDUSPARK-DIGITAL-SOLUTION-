<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EduSpark Digital Solution</title>
<link rel="stylesheet" href="style.css">

<style>
*{box-sizing:border-box}
body{margin:0;background:#f0f5fb;color:#18334f;font-family:Arial,sans-serif}
header{background:linear-gradient(120deg,#063c79,#0785e5);color:white;padding:22px;text-align:center}
header h1{margin:0;font-size:29px}
header p{margin:7px 0 0;font-size:13px}
.container{max-width:1100px;margin:22px auto;padding:12px}
.card{background:white;border-radius:15px;padding:20px;margin-bottom:18px;box-shadow:0 5px 20px #12345a12}
h2,h3{color:#0757a6}
input,select,textarea{width:100%;padding:12px;margin:7px 0 12px;border:1px solid #ccd9e8;border-radius:9px;font-size:15px}
button{border:0;border-radius:9px;padding:12px 16px;background:#0867bd;color:white;font-weight:bold;cursor:pointer}
button:disabled{opacity:.6}
.secondary{background:#e7f1fc;color:#0757a6}
.logout{background:#bd2929}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.module{background:linear-gradient(135deg,#087dca,#0753a4);color:white;text-align:left;min-height:105px;font-size:15px}
.module span{display:block;font-size:26px;margin-bottom:9px}
.hidden{display:none!important}
.stat{background:#eaf5ff;padding:15px;border-radius:10px;text-align:center}
.stat strong{display:block;font-size:25px;color:#0757a6}
label{font-size:14px;font-weight:bold;display:block}
table{width:100%;border-collapse:collapse;min-width:500px}
th,td{padding:10px;border-bottom:1px solid #e3eaf2;text-align:left;font-size:13px}
th{background:#edf4fb}
.tablewrap{overflow:auto}
#message{color:#c22;font-size:14px}
.form-grid{display:grid;grid-template-columns:1fr;gap:8px}
@media(min-width:700px){
.grid{grid-template-columns:repeat(3,1fr)}
.form-grid{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>

<body>

<header>
<h1>📘 EDUSPARK</h1>
<p>Digital Solution | School & Madrasa Management System</p>
<p>Smart Education • Better Future</p>
</header>

<div class="container">

<!-- LOGIN -->
<section id="login" class="card">
<h2>🔐 Admin Login</h2>
<p>আপনার প্রতিষ্ঠানের ইমেইল ও পাসওয়ার্ড দিয়ে লগইন করুন।</p>

<label>ইমেইল</label>
<input id="email" type="email" placeholder="Admin Email" required>

<label>পাসওয়ার্ড</label>
<input id="password" type="password" placeholder="Password" required>

<button id="loginBtn" onclick="loginUser()">লগইন করুন</button>
<button class="secondary" onclick="forgotPassword()">পাসওয়ার্ড ভুলে গেছেন?</button>

<p id="message"></p>
</section>

<!-- DASHBOARD -->
<section id="dashboard" class="hidden">

<div class="card">
<h2 id="welcome">স্বাগতম, Admin!</h2>
<p id="institution">EduSpark Management Dashboard</p>
<button class="logout" onclick="logoutUser()">Logout</button>
</div>

<div class="grid">
<div class="stat">🎓<strong id="students">০</strong>শিক্ষার্থী</div>
<div class="stat">👨‍🏫<strong id="teachers">০</strong>শিক্ষক</div>
<div class="stat">🧑‍💼<strong id="staff">০</strong>কর্মচারী</div>
<div class="stat">📢<strong id="notices">০</strong>নোটিশ</div>
</div>

<h3>📚 Management Modules</h3>
<div class="grid" id="modules"></div>

<div id="work" class="card hidden">
<h2 id="workTitle">তথ্য ব্যবস্থাপনা</h2>

<div id="formArea"></div>

<button class="secondary" onclick="closeWork()">বন্ধ করুন</button>

<h3>সংরক্ষিত তথ্য</h3>
<div class="tablewrap">
<table>
<thead id="tableHead"></thead>
<tbody id="tableBody"></tbody>
</table>
</div>
</div>

</section>
</div>

<footer style="text-align:center;padding:20px;color:#718096">
© EduSpark Digital Solution<br>
Developed by Md Kamrul Islam
</footer>

<!-- Firebase SDK -->
<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore-compat.js"></script>

<script>

// ===================================
// FIREBASE CONFIGURATION
// ===================================

const firebaseConfig = {
  apiKey: "আপনার আগের আসল Firebase API Key",
  authDomain: "eduspark-7b651.firebaseapp.com",
  projectId: "eduspark-7b651",
  storageBucket: "eduspark-7b651.firebasestorage.app",
  messagingSenderId: "441514127228",
  appId: "1:441514127228:web:17bc8743e7cef475547ef9",
  measurementId: "G-Y8WW1XJEN1"
};

// Firebase Initialize
if (!firebase.apps.length) {
  firebase.initializeApp(firebaseConfig);
}

const auth = firebase.auth();
const db = firebase.firestore();

let institutionId = null;
let currentModule = null;

// ===================================
// MODULES
// ===================================

const modules = [
 {id:"admissions",name:"অনলাইন ভর্তি",icon:"📝",fields:["শিক্ষার্থীর নাম","পিতার নাম","মাতার নাম","জন্ম তারিখ","মোবাইল","শ্রেণি"]},
 {id:"students",name:"শিক্ষার্থী",icon:"🎓",fields:["নাম","রোল","শ্রেণি","শাখা","মোবাইল"]},
 {id:"teachers",name:"শিক্ষক",icon:"👨‍🏫",fields:["শিক্ষকের নাম","বিষয়","মোবাইল","ইমেইল"]},
 {id:"staff",name:"কর্মচারী",icon:"🧑‍💼",fields:["নাম","পদবি","মোবাইল","বেতন"]},
 {id:"attendance",name:"হাজিরা",icon:"📅",fields:["নাম বা আইডি","তারিখ","ধরন","উপস্থিতি"]},
 {id:"fees",name:"বেতন ও ফি",icon:"💳",fields:["শিক্ষার্থীর নাম","মাস","টাকার পরিমাণ","পরিশোধের অবস্থা"]},
 {id:"results",name:"পরীক্ষার ফলাফল",icon:"📊",fields:["শিক্ষার্থীর নাম","শ্রেণি","পরীক্ষা","বিষয়","নম্বর","গ্রেড"]},
 {id:"notices",name:"নোটিশ",icon:"📢",fields:["শিরোনাম","তারিখ","বিস্তারিত"]},
 {id:"parents",name:"অভিভাবক",icon:"👨‍👩‍👧",fields:["নাম","শিক্ষার্থীর নাম","মোবাইল","ইমেইল"]},
 {id:"certificates",name:"ছাড়পত্র ও প্রশংসাপত্র",icon:"🏅",fields:["শিক্ষার্থীর নাম","সনদের ধরন","প্রদানের তারিখ","স্মারক নম্বর"]},
 {id:"routine",name:"ক্লাস রুটিন",icon:"🗓️",fields:["শ্রেণি","বার","বিষয়","শিক্ষক","সময়"]},
 {id:"expenses",name:"আয়-ব্যয়ের হিসাব",icon:"📒",fields:["ধরন","খাত","টাকার পরিমাণ","তারিখ"]}
];

function el(id){
  return document.getElementById(id);
}

function showMessage(message){
  el("message").textContent = message;
}

// ===================================
// LOGIN
// ===================================

async function loginUser(){

  const email = el("email").value.trim();
  const password = el("password").value;
  const btn = el("loginBtn");

  if(!email || !password){
    showMessage("ইমেইল ও পাসওয়ার্ড লিখুন।");
    return;
  }

  btn.disabled = true;
  btn.textContent = "লগইন হচ্ছে...";

  try{

    await auth.signInWithEmailAndPassword(email,password);

  }catch(error){

    const errors = {
      "auth/invalid-credential":"ইমেইল অথবা পাসওয়ার্ড ভুল।",
      "auth/user-not-found":"এই ইমেইলে কোনো অ্যাকাউন্ট নেই।",
      "auth/wrong-password":"পাসওয়ার্ড ভুল।",
      "auth/too-many-requests":"অনেকবার চেষ্টা করেছেন। পরে চেষ্টা করুন।",
      "auth/network-request-failed":"ইন্টারনেট সংযোগ পরীক্ষা করুন।"
    };

    showMessage(errors[error.code] || error.message);

  }finally{

    btn.disabled = false;
    btn.textContent = "লগইন করুন";
  }
}

// ===================================
// FORGOT PASSWORD
// ===================================

async function forgotPassword(){

  const email = el("email").value.trim();

  if(!email){
    showMessage("প্রথমে ইমেইল লিখুন।");
    return;
  }

  try{

    await auth.sendPasswordResetEmail(email);
    showMessage("পাসওয়ার্ড রিসেট লিংক ইমেইলে পাঠানো হয়েছে।");

  }catch(error){

    showMessage(error.message);
  }
}

// ===================================
// LOGOUT
// ===================================

async function logoutUser(){

  try{
    await auth.signOut();
  }catch(error){
    alert(error.message);
  }
}

// ===================================
// AUTHENTICATION
// ===================================

auth.onAuthStateChanged(async user=>{

  if(!user){

    institutionId = null;

    el("login").classList.remove("hidden");
    el("dashboard").classList.add("hidden");

    return;
  }

  try{

    const profile = await db
      .collection("admins")
      .doc(user.uid)
      .get();

    if(!profile.exists){

      alert("Admin Profile পাওয়া যায়নি।");
      await auth.signOut();
      return;
    }

    const data = profile.data();

    if(!data.institutionId || data.status !== "active"){

      alert("আপনার Admin Account সক্রিয় নয়।");
      await auth.signOut();
      return;
    }

    institutionId = data.institutionId;

    el("welcome").textContent =
      "স্বাগতম, " + (data.adminName || "Admin") + "!";

    el("institution").textContent =
      data.institutionName || "EduSpark Institution";

    el("login").classList.add("hidden");
    el("dashboard").classList.remove("hidden");

    drawModules();
    await loadCounts();

  }catch(error){

    alert("Firebase সমস্যা: " + error.message);
    await auth.signOut();
  }
});

// ===================================
// SHOW MODULES
// ===================================

function drawModules(){

  const area = el("modules");
  area.innerHTML = "";

  modules.forEach(module=>{

    const btn = document.createElement("button");

    btn.className = "module";
    btn.type = "button";

    const icon = document.createElement("span");
    icon.textContent = module.icon;

    btn.appendChild(icon);
    btn.appendChild(document.createTextNode(module.name));

    btn.onclick = ()=>openModule(module.id);

    area.appendChild(btn);
  });
}

// ===================================
// OPEN MODULE
// ===================================

function openModule(id){

  currentModule = modules.find(m=>m.id===id);

  if(!currentModule || !institutionId) return;

  el("work").classList.remove("hidden");
  el("workTitle").textContent =
    currentModule.icon + " " + currentModule.name;

  const formArea = el("formArea");
  formArea.innerHTML = "";

  const form = document.createElement("form");
  form.id = "dataForm";

  const formGrid = document.createElement("div");
  formGrid.className = "form-grid";

  currentModule.fields.forEach((field,index)=>{

    const label = document.createElement("label");
    label.textContent = field;

    const input = document.createElement("input");
    input.type = "text";
    input.required = true;
    input.id = "field" + index;
    input.placeholder = field;

    formGrid.appendChild(label);
    formGrid.appendChild(input);
  });

  const save = document.createElement("button");
  save.type = "submit";
  save.textContent = "তথ্য সংরক্ষণ করুন";

  form.appendChild(formGrid);
  form.appendChild(save);

  formArea.appendChild(form);

  form.onsubmit = saveRecord;

  el("tableHead").innerHTML =
    "<tr>" +
    currentModule.fields.map(field=>
      "<th>" + escapeHTML(field) + "</th>"
    ).join("") +
    "</tr>";

  loadRows();

  el("work").scrollIntoView({behavior:"smooth"});
}

// ===================================
// SAVE RECORD
// ===================================

async function saveRecord(event){

  event.preventDefault();

  if(!institutionId || !currentModule) return;

  const form = event.target;
  const button = form.querySelector("button");

  const data = {};

  currentModule.fields.forEach((field,index)=>{

    data[field] = el("field" + index).value.trim();
  });

  data.createdAt =
    firebase.firestore.FieldValue.serverTimestamp();

  data.createdBy = auth.currentUser.uid;

  button.disabled = true;
  button.textContent = "সংরক্ষণ হচ্ছে...";

  try{

    await db.collection("institutions")
      .doc(institutionId)
      .collection(currentModule.id)
      .add(data);

    alert("আলহামদুলিল্লাহ! তথ্য সংরক্ষিত হয়েছে।");

    form.reset();

    await loadRows();
    await loadCounts();

  }catch(error){

    alert("তথ্য সংরক্ষণ হয়নি: " + error.message);

  }finally{

    button.disabled = false;
    button.textContent = "তথ্য সংরক্ষণ করুন";
  }
}

// ===================================
// ESCAPE HTML
// ===================================

function escapeHTML(value){

  return String(value).replace(/[&<>"']/g,char=>({

    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"

  }[char]));
}

// ===================================
// LOAD RECORDS
// ===================================

async function loadRows(){

  const body = el("tableBody");

  if(!currentModule || !institutionId) return;

  body.innerHTML =
    "<tr><td>লোড হচ্ছে...</td></tr>";

  try{

    const snap = await db.collection("institutions")
      .doc(institutionId)
      .collection(currentModule.id)
      .orderBy("createdAt","desc")
      .limit(100)
      .get();

    body.innerHTML = "";

    if(snap.empty){

      body.innerHTML =
        "<tr><td>এখনো কোনো তথ্য নেই।</td></tr>";

      return;
    }

    snap.forEach(doc=>{

      const data = doc.data();
      const tr = document.createElement("tr");

      currentModule.fields.forEach(field=>{

        const td = document.createElement("td");
        td.textContent = data[field] || "-";

        tr.appendChild(td);
      });

      body.appendChild(tr);
    });

  }catch(error){

    body.innerHTML = "";

    const tr = document.createElement("tr");
    const td = document.createElement("td");

    td.textContent = "তথ্য আনা যায়নি: " + error.message;

    tr.appendChild(td);
    body.appendChild(tr);
  }
}

// ===================================
// DASHBOARD COUNTS
// ===================================

async function loadCounts(){

  if(!institutionId) return;

  const items = [
    ["students","students"],
    ["teachers","teachers"],
    ["staff","staff"],
    ["notices","notices"]
  ];

  for(const [id,collectionName] of items){

    try{

      const snap = await db.collection("institutions")
        .doc(institutionId)
        .collection(collectionName)
        .get();

      el(id).textContent =
        snap.size.toLocaleString("bn-BD");

    }catch(error){

      el(id).textContent = "—";
      console.error(error);
    }
  }
}

// ===================================
// CLOSE MODULE
// ===================================

function closeWork(){

  el("work").classList.add("hidden");
  currentModule = null;
}

console.log("EduSpark System Ready");

</script>
</body>
</html>
