<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Noorul Ilm - Admin Panel & School Management System</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: 'SolaimanLipi', Arial, sans-serif;
        }
        body {
            background-color: #f4f7f6;
            margin: 0;
            padding: 20px;
            color: #333;
        }
        h2 {
            color: #04471c;
            border-bottom: 2px solid #04471c;
            padding-bottom: 5px;
            margin-top: 0;
        }
        .card {
            background: white;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        label {
            display: block;
            margin-top: 10px;
            font-weight: bold;
            color: #555;
        }
        input, select, textarea {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
        }
        button {
            background: #04471c;
            color: white;
            border: none;
            padding: 10px 15px;
            margin-top: 15px;
            cursor: pointer;
            border-radius: 4px;
            font-size: 16px;
        }
        button:hover {
            background: #066d2c;
        }
        .edit-btn { 
            background: #f0ad4e; 
            color: white; 
            border: none; 
            padding: 5px 10px; 
            cursor: pointer; 
            border-radius: 4px; 
            margin-right: 5px; 
        } 
        .del-btn { 
            background: #d9534f; 
            color: white; 
            border: none; 
            padding: 5px 10px; 
            cursor: pointer; 
            border-radius: 4px; 
        }
        @media print { 
            body * { visibility: hidden; } 
            #printableArea, #printableArea * { visibility: visible; } 
            #printableArea { position: absolute; left: 0; top: 0; width: 100%; padding: 20px; background: white; } 
            .no-print { display: none !important; } 
        }
    </style>
</head>
<body>

    <!-- Header / Branding -->
    <div class="card no-print" style="text-align: center; background: #04471c; color: white;">
        <h1 style="margin: 0; font-size: 26px;">نور العلم - Noorul Ilm</h1>
        <p style="margin: 5px 0 0 0; font-size: 14px;">School & Madrasa Management System (Eduspark Digital Solution)</p>
        <p style="font-size: 12px; font-style: italic; margin-top: 5px;">জ্ঞান আল্লাহর দান</p>
    </div>

    <!-- Admin Login Section -->
    <section id="adminLogin" class="card no-print">
        <h2>🔐 Admin Login</h2>
        <form id="loginForm">
            <label for="adminEmail">ইমেইল</label>
            <input type="email" id="adminEmail" placeholder="Admin Email" required>
            <label for="adminPassword">পাসওয়ার্ড</label>
            <input type="password" id="adminPassword" placeholder="Password" required>
            <button type="submit" id="loginBtn">Login</button>
        </form>
        <p style="margin-top: 15px;"><button type="button" id="forgotPassword" style="background: #f0ad4e;">পাসওয়ার্ড ভুলে গেছেন?</button></p>
        <p id="loginMessage" style="color: red; font-weight: bold;"></p>
    </section>

    <!-- Admin Panel Dashboard -->
    <section id="adminPanel" class="no-print" hidden>
        <div class="card" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h2 style="border: none; margin: 0;">Admin Dashboard</h2>
                <p style="margin: 5px 0 0 0;">আপনি Admin হিসেবে সফলভাবে লগইন করেছেন।</p>
            </div>
            <button type="button" id="logoutBtn" style="background: #d9534f; margin-top: 0;">Logout</button>
        </div>

        <!-- Dashboard Stats Overview -->
        <div class="card">
            <h2>📊 ড্যাশবোর্ড ওভারভিউ</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; text-align: center;">
                <div style="background: #eaf4ec; padding: 15px; border-radius: 6px;">
                    <h3>👨‍🎓 শিক্ষার্থী</h3>
                    <p id="studentCount" style="font-size: 20px; font-weight: bold; margin: 0;">0</p>
                </div>
                <div style="background: #eaf4ec; padding: 15px; border-radius: 6px;">
                    <h3>👨‍🏫 শিক্ষক</h3>
                    <p id="teacherCount" style="font-size: 20px; font-weight: bold; margin: 0;">0</p>
                </div>
                <div style="background: #eaf4ec; padding: 15px; border-radius: 6px;">
                    <h3>🧑‍💼 কর্মচারী</h3>
                    <p id="staffCount" style="font-size: 20px; font-weight: bold; margin: 0;">0</p>
                </div>
                <div style="background: #eaf4ec; padding: 15px; border-radius: 6px;">
                    <h3>👪 অভিভাবক</h3>
                    <p id="guardianCount" style="font-size: 20px; font-weight: bold; margin: 0;">0</p>
                </div>
            </div>
        </div>

        <!-- Admission Form -->
        <div class="card">
            <h2>শিক্ষার্থী ভর্তি ফরম (কেজি থেকে ১০ম শ্রেণি)</h2>
            <form id="admissionForm">
                <input type="hidden" id="studentId">
                <label for="studentName">শিক্ষার্থীর নাম</label>
                <input type="text" id="studentName" required>
                <label for="fatherName">পিতার নাম</label>
                <input type="text" id="fatherName" required>
                <label for="motherName">মাতার নাম</label>
                <input type="text" id="motherName" required>
                <label for="dateOfBirth">জন্মতারিখ</label>
                <input type="date" id="dateOfBirth" required>
                <label for="mobile">মোবাইল নম্বর</label>
                <input type="tel" id="mobile" required>
                <label for="rollNumber">রোল নম্বর</label>
                <input type="text" id="rollNumber" required>
                <label for="department">বিভাগ নির্বাচন</label>
                <select id="department" required>
                    <option value="">বিভাগ নির্বাচন করুন</option>
                    <option value="১০ম">১০ম শ্রেণি</option>
                    <option value="kg">কেজি ও স্কুল শাখা</option>
                </select>
                <label for="className">শ্রেণি নির্বাচন</label>
                <select id="className" required>
                    <option value="">আগে বিভাগ নির্বাচন করুন</option>
                </select>
                <button type="submit" id="saveStudentBtn">ভর্তি ফরম জমা দিন</button>
            </form>
            <p id="admissionMessage" style="color: green; font-weight: bold; margin-top: 10px;"></p>
        </div>

        <div class="card">
            <h2>শিক্ষার্থীর তালিকা</h2>
            <input type="search" id="studentSearch" placeholder="শিক্ষার্থীর নাম দিয়ে খুঁজুন">
            <div id="studentList" style="margin-top: 15px;">শিক্ষার্থীর তথ্য লোড হচ্ছে...</div>
        </div>

        <!-- Student Fee Collection -->
        <div class="card">
            <h2>💳 শিক্ষার্থীর ফি আদায় ও বকেয়া রেকর্ড</h2>
            <form id="feeForm">
                <input type="hidden" id="feeRecordId">
                <label for="feeStudentName">শিক্ষার্থীর নাম ও রোল</label>
                <input type="text" id="feeStudentName" placeholder="যেমন: আব্দুল্লাহ (রোল: ১০১)" required>
                <label for="feeMonth">মাস / সেশন</label>
                <input type="text" id="feeMonth" placeholder="যেমন: জানুয়ারি ২০২৬" required>
                <label for="totalFee">মোট পাওনা ফি (টাকা)</label>
                <input type="number" id="totalFee" placeholder="যেমন: ২০০০" required>
                <label for="feePaid">পরিশোধিত (Paid)</label>
                <input type="number" id="feePaid" placeholder="যেমন: ১৫০০" required>
                <label for="feeDue">বকেয়া (Due)</label>
                <input type="number" id="feeDue" placeholder="যেমন: ৫০০" required>
                <label for="feeStatus">অবস্থা</label>
                <select id="feeStatus" required>
                    <option value="পরিশোধিত (Paid)">পরিশোধিত (Paid)</option>
                    <option value="বকেয়া আছে (Due)">বকেয়া আছে (Due)</option>
                    <option value="আংশিক পরিশোধ (Partial)">আংশিক পরিশোধ (Partial)</option>
                </select>
                <button type="submit" id="saveFeeBtn">ফি রেকর্ড সংরক্ষণ করুন</button>
            </form>
            <p id="feeMessage" style="color: green; font-weight: bold; margin-top: 10px;"></p>
        </div>

        <div class="card">
            <h2>📑 শিক্ষার্থীর ফি ও বকেয়া তালিকা</h2>
            <input type="search" id="feeSearch" placeholder="শিক্ষার্থীর নাম দিয়ে খুঁজুন">
            <div id="feeList" style="margin-top: 15px;">ফিসের তথ্য লোড হচ্ছে...</div>
        </div>

        <!-- Teacher Form & List -->
        <div class="card">
            <h2>নতুন শিক্ষক যুক্ত করুন</h2>
            <form id="teacherForm">
                <input type="hidden" id="teacherRecordId">
                <label for="teacherName">শিক্ষকের নাম</label>
                <input type="text" id="teacherName" required>
                <label for="teacherDesignation">পদবী</label>
                <input type="text" id="teacherDesignation" placeholder="যেমন: সহকারী শিক্ষক" required>
                <label for="teacherSubject">বিষয়</label>
                <input type="text" id="teacherSubject" required>
                <label for="teacherMobile">মোবাইল নম্বর</label>
                <input type="tel" id="teacherMobile" required>
                <button type="submit" id="saveTeacherBtn">শিক্ষক সংরক্ষণ করুন</button>
            </form>
            <p id="teacherMessage" style="color: green; font-weight: bold; margin-top: 10px;"></p>
        </div>

        <div class="card">
            <h2>শিক্ষকদের রেকর্ড তালিকা</h2>
            <input type="search" id="teacherSearch" placeholder="শিক্ষকের নাম দিয়ে খুঁজুন">
            <div id="teacherList" style="margin-top: 15px;">শিক্ষকদের তথ্য লোড হচ্ছে...</div>
        </div>

        <!-- Testimonial & TC Form -->
        <div class="card">
            <h2>📜 প্রশংসাপত্র ও ছাড়পত্র (Testimonial & TC) তৈরি ফরম</h2>
            <form id="certForm">
                <input type="hidden" id="certRecordId">
                <label for="certType">সনদের ধরণ নির্বাচন করুন</label>
                <select id="certType" required>
                    <option value="">ধরণ নির্বাচন করুন</option>
                    <option value="প্রশংসাপত্র (Testimonial)">প্রশংসাপত্র (Testimonial)</option>
                    <option value="ছাড়পত্র (Transfer Certificate - TC)">ছাড়পত্র (Transfer Certificate - TC)</option>
                </select>
                <label for="certStudentName">শিক্ষার্থীর নাম</label>
                <input type="text" id="certStudentName" placeholder="শিক্ষার্থীর পূর্ণ নাম" required>
                <label for="certFatherName">পিতার নাম</label>
                <input type="text" id="certFatherName" placeholder="পিতার নাম" required>
                <label for="certClass">শ্রেণি ও বিভাগ</label>
                <input type="text" id="certClass" placeholder="যেমন: ১০ম শ্রেণি" required>
                <label for="certRoll">রোল / আইডি</label>
                <input type="text" id="certRoll" placeholder="রোল নম্বর" required>
                <label for="certReason">মূল বক্তব্য / ছাড়পত্রের কারণ (ঐচ্ছিক)</label>
                <textarea id="certReason" rows="3" placeholder="ছাত্র/ছাত্রীর ভালো ফলাফল বা অন্যত্র স্থানান্তরের কারণ লিখুন..."></textarea>
                <button type="submit" id="saveCertBtn">সনদ সংরক্ষণ করুন</button>
            </form>
            <p id="certMessage" style="color: green; font-weight: bold; margin-top: 10px;"></p>
        </div>

        <div class="card">
            <h2>🖨️ সংরক্ষিত সনদ ও প্রিন্ট সিস্টেম</h2>
            <input type="search" id="certSearch" placeholder="নাম দিয়ে সনদ খুঁজুন">
            <div id="certList" style="margin-top: 15px;">সনদের তথ্য লোড হচ্ছে...</div>
        </div>
    </section>

    <!-- Print Area -->
    <div id="printableArea" style="display: none;"></div>

    <!-- Firebase Script Integration -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getAuth, signInWithEmailAndPassword, sendPasswordResetEmail, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
        import { getFirestore, collection, addDoc, setDoc, getDocs, doc, deleteDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyAzuZfOdDjztQvgEbtDoO-DQJO_1Hqnsf4",
            authDomain: "noorul-ilm-management.firebaseapp.com",
            projectId: "noorul-ilm-management",
            storageBucket: "noorul-ilm-management.firebasestorage.app",
            messagingSenderId: "1091358323396",
            appId: "1:1091358323396:web:65a0fed12ecb5c749f4f91",
            measurementId: "G-0ER6H616VF"
        };

        const ADMIN_UID = "nKQFbXGR4jMGARMcZNwhrOEggvo1";
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        const studentCollection = collection(db, "student_records");
        const teacherCollection = collection(db, "teacher_records");
        const staffCollection = collection(db, "staff_records");
        const salaryCollection = collection(db, "teacher_salary_records");
        const feeCollection = collection(db, "student_fee_records");
        const guardianCollection = collection(db, "guardian_records");
        const certCollection = collection(db, "certificate_records");

        const adminLogin = document.getElementById("adminLogin");
        const adminPanel = document.getElementById("adminPanel");
        const loginForm = document.getElementById("loginForm");
        const loginMessage = document.getElementById("loginMessage");
        
        const admissionForm = document.getElementById("admissionForm");
        const admissionMessage = document.getElementById("admissionMessage");
        const department = document.getElementById("department");
        const className = document.getElementById("className");
        const studentList = document.getElementById("studentList");
        const studentSearch = document.getElementById("studentSearch");
        const studentCount = document.getElementById("studentCount");

        const feeForm = document.getElementById("feeForm");
        const feeMessage = document.getElementById("feeMessage");
        const feeList = document.getElementById("feeList");
        const feeSearch = document.getElementById("feeSearch");

        const teacherForm = document.getElementById("teacherForm");
        const teacherMessage = document.getElementById("teacherMessage");
        const teacherList = document.getElementById("teacherList");
        const teacherSearch = document.getElementById("teacherSearch");
        const teacherCount = document.getElementById("teacherCount");

        const guardianCount = document.getElementById("guardianCount");
        const staffCount = document.getElementById("staffCount");

        const certForm = document.getElementById("certForm");
        const certMessage = document.getElementById("certMessage");
        const certList = document.getElementById("certList");
        const certSearch = document.getElementById("certSearch");
        const printableArea = document.getElementById("printableArea");

        const classes = { 
            kg: ["শিশু শ্রেণি", "১ম শ্রেণি", "২য় শ্রেণি", "৩য় শ্রেণি", "৪র্থ শ্রেণি", "৫ম শ্রেণি", "৬ষ্ঠ শ্রেণি", "৭ম শ্রেণি", "৮ম শ্রেণি", "৯ম শ্রেণি"],
            "১০ম": ["১০ম শ্রেণি"]
        };

        department.addEventListener("change", function () {
            className.innerHTML = '<option value="">শ্রেণি নির্বাচন করুন</option>';
            (classes[department.value] || []).forEach(item => {
                const option = document.createElement("option");
                option.value = item;
                option.textContent = item;
                className.appendChild(option);
            });
        });

        loginForm.addEventListener("submit", async function (e) {
            e.preventDefault();
            const email = document.getElementById("adminEmail").value.trim();
            const password = document.getElementById("adminPassword").value;
            const loginBtn = document.getElementById("loginBtn");
            loginBtn.disabled = true;
            loginBtn.textContent = "লগইন হচ্ছে...";
            try {
                const result = await signInWithEmailAndPassword(auth, email, password);
                if (result.user.uid !== ADMIN_UID) {
                    await signOut(auth);
                    loginMessage.textContent = "এই অ্যাকাউন্টের Admin অনুমতি নেই।";
                }
            } catch (err) {
                loginMessage.textContent = "লগইন হয়নি। ইমেইল ও পাসওয়ার্ড পরীক্ষা করুন।";
            } finally {
                loginBtn.disabled = false;
                loginBtn.textContent = "Login";
            }
        });

        document.getElementById("forgotPassword").addEventListener("click", async () => {
            const email = document.getElementById("adminEmail").value.trim();
            if (!email) {
                loginMessage.textContent = "প্রথমে আপনার Admin ইমেইল লিখুন।";
                return;
            }
            try {
                await sendPasswordResetEmail(auth, email);
                loginMessage.textContent = "পাসওয়ার্ড পরিবর্তনের লিংক পাঠানো হয়েছে।";
            } catch (err) {
                loginMessage.textContent = "Reset করা যায়নি।";
            }
        });

        onAuthStateChanged(auth, async (user) => {
            if (user && user.uid === ADMIN_UID) {
                adminLogin.hidden = true;
                adminPanel.hidden = false;
                await loadStudents();
                await loadFees();
                await loadTeachers();
                await loadCertificates();
                await loadCounts();
            } else {
                adminLogin.hidden = false;
                adminPanel.hidden = true;
                if (user) await signOut(auth);
            }
        });

        document.getElementById("logoutBtn").addEventListener("click", async () => {
            await signOut(auth);
            loginMessage.textContent = "আপনি Logout করেছেন।";
        });

        // Student Admission Logic
        admissionForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const id = document.getElementById("studentId").value;
            const data = {
                studentName: document.getElementById("studentName").value.trim(),
                fatherName: document.getElementById("fatherName").value.trim(),
                motherName: document.getElementById("motherName").value.trim(),
                dateOfBirth: document.getElementById("dateOfBirth").value,
                mobile: document.getElementById("mobile").value.trim(),
                roll: document.getElementById("rollNumber").value.trim(),
                department: department.value,
                className: className.value,
                createdAt: serverTimestamp()
            };
            if (id) {
                await setDoc(doc(db, "student_records", id), data, { merge: true });
                admissionMessage.textContent = "শিক্ষার্থীর তথ্য আপডেট হয়েছে।";
            } else {
                await addDoc(studentCollection, data);
                admissionMessage.textContent = "শিক্ষার্থীর তথ্য সংরক্ষিত হয়েছে।";
            }
            admissionForm.reset();
            document.getElementById("studentId").value = "";
            await loadStudents();
        });

        // Certificate Logic
        certForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const id = document.getElementById("certRecordId").value;
            const data = {
                certType: document.getElementById("certType").value,
                studentName: document.getElementById("certStudentName").value.trim(),
                fatherName: document.getElementById("certFatherName").value.trim(),
                certClass: document.getElementById("certClass").value.trim(),
                roll: document.getElementById("certRoll").value.trim(),
                reason: document.getElementById("certReason").value.trim(),
                createdAt: serverTimestamp()
            };
            if (id) {
                await setDoc(doc(db, "certificate_records", id), data, { merge: true });
                certMessage.textContent = "সনদ আপডেট হয়েছে।";
            } else {
                await addDoc(certCollection, data);
                certMessage.textContent = "সনদ সংরক্ষিত হয়েছে।";
            }
            certForm.reset();
            document.getElementById("certRecordId").value = "";
            await loadCertificates();
        });

        function escapeHTML(value) {
            return String(value ?? "").replace(/[&<>"']/g, function (char) {
                return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char];
            });
        }

        let allStudents = [];
        async function loadStudents() {
            const snap = await getDocs(studentCollection);
            allStudents = snap.docs.map(item => ({ id: item.id, ...item.data() }));
            studentCount.textContent = allStudents.length;
            showStudents(allStudents);
        }

        function showStudents(students) {
            if (students.length === 0) {
                studentList.textContent = "কোনো তথ্য নেই।";
                return;
            }
            studentList.innerHTML = "";
            students.forEach(s => {
                const card = document.createElement("div");
                card.className = "card";
                card.innerHTML = `<h3>${escapeHTML(s.studentName)}</h3><p>পিতা: ${escapeHTML(s.fatherName)}</p><p>রোল: ${escapeHTML(s.roll)} | শ্রেণি: ${escapeHTML(s.className)}</p><button type="button" class="edit-btn">Edit</button><button type="button" class="del-btn">Delete</button>`;
                card.querySelector(".edit-btn").onclick = () => {
                    document.getElementById("studentId").value = s.id;
                    document.getElementById("studentName").value = s.studentName || "";
                    document.getElementById("fatherName").value = s.fatherName || "";
                    document.getElementById("motherName").value = s.motherName || "";
                    document.getElementById("dateOfBirth").value = s.dateOfBirth || "";
                    document.getElementById("mobile").value = s.mobile || "";
                    document.getElementById("rollNumber").value = s.roll || "";
                    document.getElementById("department").value = s.department || "";
                    document.getElementById("department").dispatchEvent(new Event('change'));
                    document.getElementById("className").value = s.className || "";
                    window.scrollTo({top: 0, behavior: 'smooth'});
                };
                card.querySelector(".del-btn").onclick = async () => {
                    if(confirm("মুছতে চান?")) {
                        await deleteDoc(doc(db, "student_records", s.id));
                        loadStudents();
                    }
                };
                studentList.appendChild(card);
            });
        }

        studentSearch.addEventListener("input", (e) => {
            const txt = e.target.value.toLowerCase();
            showStudents(allStudents.filter(s => String(s.studentName || "").toLowerCase().includes(txt)));
        });

        let allCerts = [];
        async function loadCertificates() {
            const snap = await getDocs(certCollection);
            allCerts = snap.docs.map(item => ({ id: item.id, ...item.data() }));
            showCertificates(allCerts);
        }

        function showCertificates(certs) {
            if (certs.length === 0) {
                certList.textContent = "কোনো সনদ নেই।";
                return;
            }
            certList.innerHTML = "";
            certs.forEach(c => {
                const card = document.createElement("div");
                card.className = "card";
                card.innerHTML = `
                    <h3>${escapeHTML(c.certType)}</h3>
                    <p>শিক্ষার্থী: ${escapeHTML(c.studentName)} | পিতা: ${escapeHTML(c.fatherName)}</p>
                    <button type="button" class="print" style="background:#04471c; color:white; border:none; padding:6px 12px; cursor:pointer; margin-right:5px; border-radius:4px;">🖨️ প্রিন্ট করুন</button>
                    <button type="button" class="edit-btn">Edit</button>
                    <button type="button" class="del-btn">Delete</button>
                `;
                card.querySelector(".print").onclick = () => printCertificate(c);
                card.querySelector(".edit-btn").onclick = () => {
                    document.getElementById("certRecordId").value = c.id;
                    document.getElementById("certType").value = c.certType || "";
                    document.getElementById("certStudentName").value = c.studentName || "";
                    document.getElementById("certFatherName").value = c.fatherName || "";
                    document.getElementById("certClass").value = c.certClass || "";
                    document.getElementById("certRoll").value = c.roll || "";
                    document.getElementById("certReason").value = c.reason || "";
                    window.scrollTo({top: 0, behavior: 'smooth'});
                };
                card.querySelector(".del-btn").onclick = async () => {
                    if(confirm("মুছতে চান?")) {
                        await deleteDoc(doc(db, "certificate_records", c.id));
                        loadCertificates();
                    }
                };
                certList.appendChild(card);
            });
        }

        function printCertificate(c) {
            printableArea.style.display = "block";
            printableArea.innerHTML = `
                <div style="text-align: center; border: 5px double #04471c; padding: 30px; font-family: 'SolaimanLipi', sans-serif;">
                    <h1 style="color: #04471c; margin: 0; font-size: 28px;">نور العلم - Noorul Ilm</h1>
                    <p style="margin: 5px 0 20px 0; font-size: 14px;">School &amp; Madrasa Management System</p>
                    <hr style="border: 1px solid #04471c; width: 60%; margin: 0 auto 20px auto;">
                    <h2 style="text-decoration: underline; margin-bottom: 25px; color: #333;">${escapeHTML(c.certType)}</h2>
                    <p style="font-size: 18px; line-height: 1.8; text-align: justify; margin: 0 40px;">
                        এই মর্মে প্রত্যয়ন করা যাইতেছে যে, <strong>${escapeHTML(c.studentName)}</strong>, পিতা: <strong>${escapeHTML(c.fatherName)}</strong>, আমাদের অত্র প্রতিষ্ঠান <strong>নূরুল ইলম স্কুল ও মাদরাসা</strong>-এর <strong>${escapeHTML(c.certClass)}</strong> বিভাগের একজন নিয়মিত শিক্ষার্থী ছিল। তাহার রোল নম্বর: <strong>${escapeHTML(c.roll)}</strong>।
                    </p>
                    <p style="font-size: 18px; line-height: 1.8; text-align: justify; margin: 15px 40px 40px 40px;">
                        ${escapeHTML(c.reason || "অত্র প্রতিষ্ঠানে অধ্যয়নকালে তাহার চরিত্র, আচরণ ও ফলাফল সন্তোষজনক ছিল। আমরা তাহার সর্বাঙ্গীন সাফল্য ও উজ্জ্বল ভবিষ্যৎ কামনা করি।")}
                    </p>
                    <div style="display: flex; justify-content: space-between; margin-top: 80px; padding: 0 50px;">
                        <div style="border-top: 1px solid #000; width: 200px; text-align: center; padding-top: 5px;">শ্রেণি শিক্ষক</div>
                        <div style="border-top: 1px solid #000; width: 200px; text-align: center; padding-top: 5px;">প্রধান শিক্ষক / প্রিন্সিপাল</div>
                    </div>
                </div>
            `;
            window.print();
            printableArea.style.display = "none";
        }

        async function loadCounts() {
            const tSnap = await getDocs(teacherCollection);
            teacherCount.textContent = tSnap.size;
            const sSnap = await getDocs(staffCollection);
            if(staffCount) staffCount.textContent = sSnap.size;
            const gSnap = await getDocs(guardianCollection);
            if(guardianCount) guardianCount.textContent = gSnap.size;
        }

        async function loadFees() {
            const snap = await getDocs(feeCollection);
            const fees = snap.docs.map(item => ({ id: item.id, ...item.data() }));
            const feeListEl = document.getElementById("feeList");
            if(fees.length === 0) {
                feeListEl.textContent = "কোনো ফি রেকর্ড নেই।";
                return;
            }
            feeListEl.innerHTML = "";
            fees.forEach(f => {
                const card = document.createElement("div");
                card.className = "card";
                card.innerHTML = `<h3>${escapeHTML(f.studentName)} (${escapeHTML(f.month)})</h3><p>মোট: ৳${escapeHTML(f.totalFee)} | পরিশোধ: ৳${escapeHTML(f.feePaid)} | বকেয়া: ৳${escapeHTML(f.feeDue)}</p>`;
                feeListEl.appendChild(card);
            });
        }

        async function loadTeachers() {
            const snap = await getDocs(teacherCollection);
            const teachers = snap.docs.map(item => ({ id: item.id, ...item.data() }));
            if(teachers.length === 0) {
                teacherList.textContent = "কোনো তথ্য নেই।";
                return;
            }
            teacherList.innerHTML = "";
            teachers.forEach(t => {
                const card = document.createElement("div");
                card.className = "card";
                card.innerHTML = `<h3>${escapeHTML(t.teacherName)}</h3><p>পদবী: ${escapeHTML(t.designation)} | বিষয়: ${escapeHTML(t.subject)}</p>`;
                teacherList.appendChild(card);
            });
        }
    </script>
</body>
</html>
