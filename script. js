// HTML element
const el = id => document.getElementById(id);

// বার্তা দেখানো
function showMessage(message, color = "red") {
  const box = el("message");
  if (!box) return;

  box.textContent = message;
  box.style.color = color;
}

// ======================================
// LOGIN
// ======================================

async function loginUser() {
  const email = el("email")?.value.trim();
  const password = el("password")?.value;

  if (!email || !password) {
    showMessage("ইমেইল ও পাসওয়ার্ড লিখুন।");
    return;
  }

  const button = el("loginBtn");
  if (button) {
    button.disabled = true;
    button.textContent = "লগইন হচ্ছে...";
  }

  try {
    await auth.signInWithEmailAndPassword(email, password);
    showMessage("লগইন সফল হয়েছে।", "green");
  } catch (error) {
    showMessage("লগইন হয়নি: " + error.message);
  } finally {
    if (button) {
      button.disabled = false;
      button.textContent = "লগইন";
    }
  }
}

// পাসওয়ার্ড ভুলে গেলে
async function forgotPassword() {
  const email = el("email")?.value.trim();

  if (!email) {
    showMessage("আগে ইমেইল লিখুন।");
    return;
  }

  try {
    await auth.sendPasswordResetEmail(email);
    showMessage("পাসওয়ার্ড রিসেট লিংক ইমেইলে পাঠানো হয়েছে।", "green");
  } catch (error) {
    showMessage("সমস্যা হয়েছে: " + error.message);
  }
}

// ======================================
// LOGIN STATUS
// ======================================

auth.onAuthStateChanged(async user => {
  if (!user) {
    institutionId = "";
    if (el("login")) el("login").style.display = "block";
    if (el("dashboard")) el("dashboard").style.display = "none";
    return;
  }

  try {
    const adminDoc = await db.collection("admins").doc(user.uid).get();

    if (!adminDoc.exists) {
      showMessage("আপনার Admin অ্যাকাউন্টের তথ্য পাওয়া যায়নি।");
      await auth.signOut();
      return;
    }

    const admin = adminDoc.data();

    if (admin.status && admin.status !== "active") {
      showMessage("আপনার অ্যাকাউন্ট বর্তমানে সক্রিয় নয়।");
      await auth.signOut();
      return;
    }

    institutionId = admin.institutionId;
    institutionName = admin.institutionName || "EduSpark প্রতিষ্ঠান";

    if (!institutionId) {
      showMessage("Admin অ্যাকাউন্টে Institution ID নেই।");
      await auth.signOut();
      return;
    }

    if (el("login")) el("login").style.display = "none";
    if (el("dashboard")) el("dashboard").style.display = "block";

    if (el("welcome")) {
      el("welcome").textContent =
        "স্বাগতম, " + (admin.adminName || user.email);
    }

    if (el("institution")) {
      el("institution").textContent = institutionName;
    }

    drawModules();
    await loadCounts();

  } catch (error) {
    showMessage("ডেটা লোড করতে সমস্যা: " + error.message);
  }
});

