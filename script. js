// ======================================
// MODULE BUTTONS
// ======================================

function drawModules() {
  const container = el("modules");
  if (!container) return;

  container.innerHTML = "";

  moduleList.forEach(module => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "module-button";
    button.textContent = module.name;

    button.addEventListener("click", () => {
      openModule(module.id);
    });

    container.appendChild(button);
  });
}

// ======================================
// MODULE OPEN
// ======================================

function openModule(moduleId) {
  const module = moduleList.find(item => item.id === moduleId);
  if (!module || !institutionId) return;

  currentModule = moduleId;

  if (el("work")) el("work").style.display = "block";
  if (el("workTitle")) el("workTitle").textContent = module.name;

  const area = el("formArea");
  if (area) {
    area.innerHTML = `
      <form id="dataForm">
        <div class="form-grid">
          ${module.fields.map((field, index) => `
            <label>
              ${field}
              <input
                type="text"
                name="field${index}"
                placeholder="${field} লিখুন"
                required
              >
            </label>
          `).join("")}
        </div>
        <button type="submit">তথ্য সংরক্ষণ করুন</button>
      </form>
      <p id="saveMessage"></p>
    `;

    el("dataForm").addEventListener("submit", saveRecord);
  }

  loadRows();
}

// ======================================
// SAVE DATA
// ======================================

async function saveRecord(event) {
  event.preventDefault();

  if (!institutionId || !currentModule) {
    alert("প্রতিষ্ঠানের তথ্য পাওয়া যায়নি।");
    return;
  }

  const module = moduleList.find(item => item.id === currentModule);
  const formData = new FormData(event.target);
  const record = {};

  module.fields.forEach((field, index) => {
    record[field] = formData.get("field" + index) || "";
  });

  record.createdAt = firebase.firestore.FieldValue.serverTimestamp();

  const button = event.target.querySelector("button");
  button.disabled = true;
  button.textContent = "সংরক্ষণ হচ্ছে...";

  try {
    await db
      .collection("institutions")
      .doc(institutionId)
      .collection(currentModule)
      .add(record);

    el("saveMessage").textContent = "আলহামদুলিল্লাহ! তথ্য সংরক্ষণ হয়েছে।";
    el("saveMessage").style.color = "green";

    event.target.reset();
    await loadRows();
    await loadCounts();

  } catch (error) {
    el("saveMessage").textContent = "সংরক্ষণ হয়নি: " + error.message;
    el("saveMessage").style.color = "red";
  } finally {
    button.disabled = false;
    button.textContent = "তথ্য সংরক্ষণ করুন";
  }
}

// ======================================
// LOAD TABLE DATA
// ======================================

async function loadRows() {
  const module = moduleList.find(item => item.id === currentModule);
  const head = el("tableHead");
  const body = el("tableBody");

  if (!module || !head || !body) return;

  head.innerHTML = "";
  body.innerHTML = "";

  module.fields.forEach(field => {
    const th = document.createElement("th");
    th.textContent = field;
    head.appendChild(th);
  });

  try {
    const snapshot = await db
      .collection("institutions")
      .doc(institutionId)
      .collection(currentModule)
      .orderBy("createdAt", "desc")
      .limit(100)
      .get();

    snapshot.forEach(doc => {
      const data = doc.data();
      const tr = document.createElement("tr");

      module.fields.forEach(field => {
        const td = document.createElement("td");
        td.textContent = data[field] || "";
        tr.appendChild(td);
      });

      body.appendChild(tr);
    });

  } catch (error) {
    console.error("তথ্য লোড সমস্যা:", error);
    body.innerHTML =
      `<tr><td colspan="${module.fields.length}">তথ্য লোড করা যায়নি।</td></tr>`;
  }
}

// ======================================
// DASHBOARD COUNTS
// ======================================

async function loadCounts() {
  if (!institutionId) return;

  const countModules = [
    ["students", "students"],
    ["teachers", "teachers"],
    ["staff", "staff"],
    ["notices", "notices"]
  ];

  for (const [moduleId, elementId] of countModules) {
    try {
      const snapshot = await db
        .collection("institutions")
        .doc(institutionId)
        .collection(moduleId)
        .get();

      if (el(elementId)) {
        el(elementId).textContent = snapshot.size;
      }
    } catch (error) {
      console.error(moduleId + " count error:", error);
    }
  }
}

